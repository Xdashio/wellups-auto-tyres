{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "wellups-auto-tyres",
  "compatibility_date": "2025-09-18",
  "compatibility_flags": [
    // Enable Node.js API
    // see https://developers.cloudflare.com/workers/configuration/compatibility-flags/#nodejs-compatibility-flag
    "nodejs_compat",
    // Allow to fetch URLs in your app
    // see https://developers.cloudflare.com/workers/configuration/compatibility-flags/#global-fetch-strictly-public
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      // The service should match the "name" of your worker
      "service": "wellups-auto-tyres"
    }
  ],
  "vars": {
    "NEXT_PUBLIC_SUPABASE_URL": "https://odammhhhryyepynnilbr.supabase.co",
    "NEXT_PUBLIC_SUPABASE_ANON_KEY": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Im9kYW1taGhocnl5ZXB5bm5pbGJyIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODk5MjQxNDYsImV4cCI6MjEwNTUwMDE0Nn0.XGmfQ_CyhD41gM_Xvbk9u9cBDIV-ipACoIB1q_16KZA"
  }
}
